# API (Nest) — copy sang .env ở root hoặc set khi chạy
# PORT phải khớp origin trong NEXT_PUBLIC_API_URL / EXPO_PUBLIC_API_URL (mặc định 3000)
# PORT=3000

DATABASE_URL=postgresql://novalimo:novalimo@localhost:5432/novalimo
# Hoặc tách:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=novalimo
# DB_PASSWORD=novalimo
# DB_NAME=novalimo

# OSRM (routing / ma trận khoảng cách). Docker profile osrm: http://localhost:5000
OSRM_BASE_URL=http://localhost:5000

# Điều phối (dispatch): gom cụm PostGIS ST_ClusterDBSCAN (Web Mercator, eps mét) hoặc k-means JS
# DISPATCH_CLUSTER_MODE=postgres
# DISPATCH_CLUSTER_MODE=kmeans
DISPATCH_CLUSTER_MODE=postgres
DISPATCH_CLUSTER_EPS_M=500
# Log chi tiết ma trận OSRM (dev)
# DISPATCH_LOG_MATRICES=true

# JWT (driver/admin) — đổi trong production
JWT_SECRET=change-me-in-production

# Next.js public API URL (web-booking / web-admin)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Expo app-driver (Android emulator: http://10.0.2.2:3000/api)
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# --- Ma trận đồng bộ monorepo (một “sự thật” cho REST base + socket) ---
# REST: mọi client dùng cùng base kết thúc bằng /api (Nest globalPrefix).
# Socket.io: KHÔNG nằm dưới /api — kết nối tới ${origin}/realtime (origin = bỏ hậu tố /api).
# Chuẩn (test): libs/utils-core getSocketOriginFromApiBaseUrl; Next/Expo: getSocketBaseUrl() trong lib/api hoặc client.

# Web booking: gợi ý địa chỉ dùng GET /api/geocode (Nominatim, không cần key). Tuỳ chọn Google Places sau này:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NovaLimo — copy to `.env` at the repo root. The API validates every value at boot
# (apps/api-server/src/config/env.ts) and refuses to start with unsafe production settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Do NOT set NODE_ENV here: Nx loads this file into every task (incl. `next build`).
PORT=3000
# PostgreSQL 16 + PostGIS 3 (docker compose up -d postgres)
DATABASE_URL=postgresql://novalimo:novalimo@localhost:5432/novalimo
# DATABASE_SSL=true
# TYPEORM_LOGGING=true
# Migrations run automatically on boot outside production. In production run
# `nx run api-server:db -- migrate` in the release step instead.
# DB_MIGRATE_ON_BOOT=false

# ≥ 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-please-change-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Browser origins allowed for REST + Socket.io (web-booking, web-admin)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
PUBLIC_BASE_URL=http://localhost:3000
UPLOADS_DIR=uploads

# ── Payments (VietQR + bank-transfer webhook, e.g. SePay) ────────────────────
BANK_BIN=970436
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=CONG TY NOVALIMO
# Webhook sends `Authorization: Apikey <secret>` to POST /api/payments/webhooks/bank
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-0123456789
PAYMENT_HOLD_MIN=15

# ── SMS / OTP ────────────────────────────────────────────────────────────────
# `console` prints messages (incl. OTP codes) to the API log — development only.
SMS_PROVIDER=console
# SMS_API_KEY=
# SMS_API_SECRET=

# ── Maps & dispatch ──────────────────────────────────────────────────────────
GEOCODER_USER_AGENT=NovaLimo/1.0 (ops@novalimo.vn)
# OSRM_BASE_URL=http://localhost:5000
DISPATCH_CLUSTER_EPS_M=500

# ── Seed (dev / staging only: nx run api-server:db -- seed) ──────────────────
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_DRIVER_PASSWORD=Driver@12345

# ── Clients ──────────────────────────────────────────────────────────────────
# REST base ends with /api; Socket.io connects to the origin + /realtime (not under /api).
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Android emulator: http://10.0.2.2:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

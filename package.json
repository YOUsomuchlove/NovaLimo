{
  "name": "@limousine-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:all": "nx run-many --target=serve --projects=api-server,web-admin,web-booking",
    "dev:api": "nx serve api-server",
    "dev:admin": "nx serve web-admin",
    "dev:booking": "nx serve web-booking",
    "build:all": "nx run-many --target=build --all",
    "lint:all": "nx run-many --target=lint --all",
    "verify:integration": "node tools/verify-integration.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "docker:stack": "docker compose -f docker-compose.yml -f docker-compose.stack.yml up --build",
    "docker:stack:build": "docker compose -f docker-compose.yml -f docker-compose.stack.yml build",
    "docker:stack:build:sequential": "docker compose -f docker-compose.yml -f docker-compose.stack.yml build api && docker compose -f docker-compose.yml -f docker-compose.stack.yml build web-booking web-admin",
    "docker:stack:up": "docker compose -f docker-compose.yml -f docker-compose.stack.yml up -d"
  },
  "private": true,

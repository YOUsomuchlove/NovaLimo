{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["apps/app-driver/src/*"],
      "@limousine-workspace/design-tokens": ["libs/design-tokens/src/index.ts"],
      "@limousine-workspace/shared-mobile-ui": [
        "libs/shared-mobile-ui/src/index.ts"
      ],
      "@limousine-workspace/shared-types": ["libs/shared-types/src/index.ts"],
      "@limousine-workspace/shared-types/legacy": [
        "libs/shared-types/src/legacy.ts"
      ],
      "@limousine-workspace/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@limousine-workspace/shared-ui/legacy": ["libs/shared-ui/src/legacy.ts"],
      "@limousine-workspace/utils-core": ["libs/utils-core/src/index.ts"],
      "@limousine-workspace/utils-map": ["libs/utils-map/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.js"]
}

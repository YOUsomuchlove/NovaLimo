{
  "expo": {
    "name": "NovaLimo Driver",
    "slug": "novalimo-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "novalimo-driver",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/osm-tile-nav.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "plugins": ["expo-font", "expo-location", ["expo-camera", { "cameraPermission": "Quét QR chứng từ hàng hóa." }], "expo-notifications"]
  }
}

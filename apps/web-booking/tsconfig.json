{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "baseUrl": "../..",
    "paths": {
      "@limousine-workspace/shared-types": ["libs/shared-types/src/index.ts"],
      "@limousine-workspace/utils-core": ["libs/utils-core/src/index.ts"],
      "@limousine-workspace/utils-map": ["libs/utils-map/src/index.ts"],
      "@limousine-workspace/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@/*": ["apps/web-booking/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

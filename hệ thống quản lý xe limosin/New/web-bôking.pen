            20
          ],
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "wbT7c65ee0b0a",
              "fill": "#D4AF37",
              "content": "Hàng nào bị từ chối?",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "900"
            },
            {
              "type": "text",
              "id": "wbT6daeaf2a26",
              "fill": "#E8EAEF",
              "lineHeight": 1.55,
              "content": "Chất dễ cháy/nổ, hàng cấm theo luật, hàng không khớp mô tả sau kiểm tra. Danh mục chi tiết được nhắc trên báo giá.",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            }
          ]
        },

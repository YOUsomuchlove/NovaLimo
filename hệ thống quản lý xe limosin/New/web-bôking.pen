          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "wbTcf68b5efac",
              "fill": "#D4AF37",
              "content": "Ký gửi hàng có tính COD không?",
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "900"
            },
            {
              "type": "text",
              "id": "wbT886e87d1f0",
              "fill": "#E8EAEF",
              "lineHeight": 1.55,
              "content": "Có — khai báo số tiền thu hộ khi đặt gửi. Phí dịch vụ và điều kiện đối soát hiển thị trước khi bạn xác nhận.",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "wbFq7354d474bd",
          "x": 80,
          "y": 380,
          "width": 1280,
          "fill": "#FFFFFF10",
          "cornerRadius": 14,
